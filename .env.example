# Шаблон переменных окружения. Скопируй в .env и подставь свои значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Telegram API (получить на https://my.telegram.org → API development tools)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=osint_session

# Токен Telegram-бота от @BotFather
OSINT_BOT_TOKEN=your_bot_token

# Telegram ID пользователей, которым разрешены команды бота (через запятую).
# Пусто = доступ открыт всем (НЕ рекомендуется).
OSINT_BOT_ALLOWED_USERS=

# Необязательно: путь к локальной копии snoop
# SNOOP_DIR=D:\path\to\snoop
